                [ "1. Czekamy na Mikołaja", "2. List do Mikołaja", "3. Fabryka zabawek", "4. Myślenie algorytmiczne: trasa reniferów na dywanie", "5. Inżynieria: most dla sań Mikołaja" ],
                [ "1. Zima tuż tuż", "2. Śnieg i lód", "3. Ubrania na zimę", "4. Badamy topnienie lodu: edukacja badawcza", "5. Tworzymy sztuczny śnieg (działania sensoryczne)" ],
                [ "1. Tradycje świąteczne", "2. Choinka i ozdoby", "3. Kolędy", "4. Bombki w rytmach matematycznych", "5. Warsztaty uważności: zapach i magia świąt" ],
                [ "1. Zimowy karnawał", "2. Maski balowe", "3. Radosny czas", "4. Projektujemy stroje z folii i gazet", "5. Muzyka z butelek i szklanek (akustyka)" ]
            ],
            "Styczeń": [
                [ "1. Nowy Rok", "2. Kalendarz i czas", "3. Cztery pory roku", "4. Zegar z klocków: pojęcia czasu (kodowanie)", "5. Konstruujemy klepsydrę z butelek" ],
                [ "1. Dzień Babci i Dziadka", "2. Szacunek dla starszych", "3. Prezenty od serca", "4. Warsztaty rękodzieła tkackiego", "5. Drzewo genealogiczne: układy logiczne" ],
                [ "1. Kosmos i planety", "2. Rakiety", "3. Księżyc i gwiazdy", "4. Baza kosmiczna: konstrukcja z kartonów", "5. Gwiezdne konstelacje z pianek i wykałaczek" ],
                [ "1. Dokarmiamy ptaki", "2. Zwierzęta zimą", "3. Karmnik", "4. Ekologiczne kule dla ptaków (działania terenowe)", "5. Trening wyciszenia: cisza zimowego lasu" ]
            ],
            "Luty": [
                [ "1. Baśnie i bajki", "2. W krainie magii", "3. Moja ulubiona książka", "4. Teatr cieni z latarką (badanie światła)", "5. Kodujemy zamek dla księżniczki" ],
                [ "1. Muzyka wokół nas", "2. Instrumenty", "3. Koncert w przedszkolu", "4. Konstruujemy własne instrumenty z recyklingu", "5. Warsztaty relaksacyjne przy muzyce klasycznej" ],
                [ "1. Wynalazki i technika", "2. Dawniej i dziś", "3. Środki transportu", "4. Budujemy maszynę prostą (reakcja łańcuchowa)", "5. Myślenie algorytmiczne: lot samolotu po macie" ],
                [ "1. Żywioły", "2. Ogień i woda", "3. Ziemia i powietrze", "4. Wulkan ze sody i octu: reakcje chemiczne", "5. Sensoryczne badanie właściwości wiatru" ]
            ],
            "Marzec": [
                [ "1. Przedwiośnie", "2. Zwiastuny wiosny", "3. Powroty ptaków", "4. Lornetki badaczy: z lupą szukamy pąków", "5. Trening uważności z pierwszymi promieniami słońca" ],
                [ "1. Marcowa pogoda", "2. Wiosenne burze", "3. Tęcza", "4. Rozszczepienie światła: łapiemy tęczę pryzmatem", "5. Kodujemy pogodowe rytmy na dywanie" ],
                [ "1. Wiosna w ogrodzie", "2. Prace porządkowe", "3. Narzędzia ogrodnicze", "4. Inżynieria ogrodowa: system nawadniania z rurek", "5. Sadzimy cebulki: codzienne obserwacje przyrodnicze" ],
                [ "1. Zwierzęta na wsi", "2. Życie na farmie", "3. Czego dają nam zwierzęta", "4. Budujemy makietę nowoczesnej farmy", "5. Sensoryczne zagrody (siano, ziarno, wełna)" ]
            ],
            "Kwiecień": [
                [ "1. Wielkanocne tradycje", "2. Pisanki i kraszanki", "3. Koszyczek wielkanocny", "4. Barwienie jajek barwnikami naturalnymi (eksperyment)", "5. Matematyczne rytmy i symetria na pisankach" ],
                [ "1. Dzień Ziemi", "2. Dbamy o planetę", "3. Czyste środowisko", "4. Recyklingowa straż: segregacja na czas", "5. Tworzymy papier czerpany ze starych gazet" ],
                [ "1. Tajemnice wody", "2. Rzeki i jeziora", "3. Dlaczego woda jest ważna?", "4. Doświadczenia z tonięciem i pływaniem (wyporność)", "5. Wodne tory przeszkód (właściwości płynów)" ],
                [ "1. Książka moim przyjacielem", "2. Jak powstaje książka", "3. Biblioteka", "4. Kodowanie ilustracji baśniowych na dywanie", "5. Introligatorstwo: tworzymy własne notesy" ]
            ],
            "Maj": [
                [ "1. Moja miejscowość", "2. Zabytki", "3. Flaga i godło (Majówka)", "4. Konstruowanie wieży ciśnień z klocków", "5. Spacer z kompasem po okolicy przedszkola" ],
                [ "1. Wiosenna łąka", "2. Owady i pajęczaki", "3. Kwiaty łąkowe", "4. Budujemy hotel dla owadów (prace terenowe)", "5. Trening wyciszenia: słuchamy brzęczenia pszczół" ],
                [ "1. Moja Mama", "2. Mój Tata", "3. Kocham Rodziców", "4. Perfumy dla Mamy z płatków kwiatów (sensoryka)", "5. Kodowanie ramki na zdjęcia dla rodziców" ],
                [ "1. Zawody", "2. Kto nam pomaga?", "3. Praca dorosłych", "4. Tworzymy narzędzia z mas plastycznych", "5. Planowanie trasy wozu strażackiego na macie" ]
            ],
            "Czerwiec": [
                [ "1. Dzień Dziecka", "2. Dzieci całego świata", "3. Moje prawa", "4. Międzynarodowe eksperymenty ze smakiem i zapachem", "5. Budujemy makietę wioski (współpraca i sprawczość)" ],
                [ "1. Lato, lato", "2. Kolory lata", "3. Letnie owoce", "4. Edukacja badawcza: robimy owocowe lody z zamrażarki", "5. Sensoryczne plaże w kuwetach (piasek i woda)" ],
                [ "1. Jedziemy na wakacje", "2. Podróże małe i duże", "3. Wakacyjny plecak", "4. Konstruowanie statku i weryfikacja jego wyporności", "5. Algorytmiczne planowanie wycieczki na dywanie" ],
                [ "1. Bezpieczne wakacje", "2. Słońce i woda", "3. Pożegnanie przedszkola", "4. Kodowanie bezpieczeństwa nad wodą (rozwiązywanie problemów)", "5. Zamykamy wspomnienia: tworzenie kapsuły czasu" ]
            ]
        };

        // SZABLONY DNI TYGODNIA - poprawiona terminologia na j. polski, dopasowana do PPWP i kompetencji kluczowych
        const planTemplates = {
            pn: [
                { syt: `Rozmowa kierowana. Wprowadzenie w świat: {theme} poprzez mapowanie myśli za pomocą piktogramów.`, cel: `Rozpoznaje własne emocje. Inicjuje dyskusję i formułuje poprawne zdania.`, obszar: `Społeczny / Emocjonalny`, komp: `Osobiste i społeczne` },
                { syt: `Trening uważności. Zaprezentowanie rekwizytu/zagadki wprowadzającej do zagadnienia: {theme}. Otwarta dyskusja i stawianie hipotez.`, cel: `Osiąga stan skupienia. Zwraca uwagę na detal, wyciąga logiczne wnioski.`, obszar: `Poznawczy`, komp: `Umiejętność uczenia się` }
            ],
            wt: [
                { syt: `Edukacja badawcza. Manipulowanie, testowanie właściwości obiektów powiązanych z motywem: {theme}. Praca z narzędziami pomiarowymi.`, cel: `Wykazuje postawę badawczą. Weryfikuje pomysły drogą doświadczalną.`, obszar: `Poznawczy / Fizyczny`, komp: `Matematyczne i przyrodnicze` },
                { syt: `Myślenie algorytmiczne. Tworzenie i odczytywanie prostych kodów ruchowych na macie w nawiązaniu do: {theme}.`, cel: `Dekoduje znaki graficzne. Planuje proces ruchowy krok po kroku.`, obszar: `Poznawczy / Fizyczny`, komp: `Cyfrowe (bezekranowe)` }
            ],
            sr: [
                { syt: `Działania twórcze (materiały nieustrukturyzowane). Konstruowanie asymetrycznych form przestrzennych inspirowanych zagadnieniem: {theme}.`, cel: `Uruchamia inwencję przestrzenną. Rozwija motorykę małą i chwyt pęsetowy.`, obszar: `Fizyczny / Poznawczy`, komp: `Przedsiębiorczości (inicjatywa)` },
                { syt: `Sytuacja zadaniowa metodą projektów. Twórcze rozwiązywanie problemu zainicjowanego przez nauczyciela wokół tematyki: {theme}.`, cel: `Negocjuje rozwiązania z rówieśnikiem. Buduje poczucie własnej sprawczości.`, obszar: `Społeczny / Poznawczy`, komp: `Osobiste i społeczne` }
            ],
            cz: [
                { syt: `Edukacja terenowa (obserwacje w ogrodzie). Przeniesienie pola badawczego: {theme} w środowisko naturalne. Wykorzystanie darów natury.`, cel: `Integruje zmysły z naturą. Kształtuje postawy proekologiczne.`, obszar: `Fizyczny / Poznawczy`, komp: `Przyrodnicze` },
                { syt: `Matematyka w działaniu. Rytmy, segregowanie i przeliczanie z użyciem zbiorów obiektów, których dotyczy: {theme}. Dostrzeganie symetrii.`, cel: `Klasyfikuje obiekty. Przelicza w zakresie dostosowanym do możliwości 4-latków.`, obszar: `Poznawczy`, komp: `Matematyczne` }
            ],
            pt: [
                { syt: `Ekspresja twórcza. Swobodna interpretacja poznanego zagadnienia: {theme} poprzez intuicyjne działania plastyczne i taniec.`, cel: `Prezentuje twórczość bez oceny. Buduje odporność na błędy (rezyliencję).`, obszar: `Emocjonalny / Fizyczny`, komp: `Świadomość i ekspresja kulturalna` },
                { syt: `Muzykoterapia i podsumowanie badawcze: {theme}. Praca z instrumentarium naturalnym. Wspólne stworzenie teczki tematycznej.`, cel: `Wyraża emocje w muzyce. Dostrzega wartość pracy zespołowej.`, obszar: `Emocjonalny / Społeczny`, komp: `Świadomość i ekspresja kulturalna` }
            ]
        };

        const daysKeys = ['pn', 'wt', 'sr', 'cz', 'pt'];
        const dayNames = ['Poniedziałek', 'Wtorek', 'Środa', 'Czwartek', 'Piątek'];

        // GENERATORY DYNAMICZNYCH ZABAW NA BAZIE TEMATU
        function generateDynamicLists(theme) {
            const t = `<span class="dynamic-theme">${theme}</span>`;
            
            const ruchowe = [
                `1. „Ruchowa interpretacja” - zabawa naśladowcza i trening wyciszenia. Dzieci ruchem i oddechem interpretują motyw: ${t}.`,
                `2. „Wyścig odkrywców” - bieg orientacyjny z elementami kodowania przestrzennego. Szukamy rekwizytów powiązanych z zagadnieniem: ${t}.`,
                `3. „Lustrzane odbicie” - zabawa w parach. Jedno dziecko pokazuje ruchy kojarzące się z dzisiejszym tematem, drugie je naśladuje, budując empatię.`,
                `4. „Zwinne omijanie” - sensoryczny tor przeszkód, na końcu którego Słoneczka układają lub klasyfikują symbol związany z motywem: ${t}.`,
                `5. „Zabawa orientacyjno-porządkowa (reakcja na sygnał)” - trening hamowania i kontroli impulsów. Dzieci reagują ruchem na hasła związane z: ${t}.`,
                `6. „Taniec żywiołów” - improwizacja ruchowa z wykorzystaniem chusty animacyjnej do opowieści inspirowanej bieżącym tygodniem.`
            ];

            const powietrze = [
                `1. „Sztuka ziemi” - tworzenie na trawie kompozycji przestrzennych z darów natury (szyszki, patyki), nawiązujących bezpośrednio do: ${t}.`,
                `2. „Detektywi przyrody” - edukacja terenowa z użyciem lup i lornetek. Szukamy w ogrodzie śladów i połączeń z zagadnieniem: ${t}.`,
                `3. „Konstruktorzy na świeżym powietrzu” - budowanie baz, struktur i układów w piaskownicy (rozwój wyobraźni i wytrwałości).`,
                `4. „Plenerowy trening świadomej obserwacji” - spacer uważności, podczas którego dzieci szukają tekstur i dźwięków przypominających im: ${t}.`,
                `5. „Eksperyment w plenerze” - badanie zjawisk fizycznych (wiatr, światło, grawitacja) i ich wpływu na obiekty omawiane w tym tygodniu.`
            ];

            const edukacyjne = [
                `1. „Rozmowa kierowana” - tworzenie zespołowej mapy myśli na dywanie, obrazującej wszystko, co wiemy o: ${t}.`,
                `2. „Tace badawcze (luźne elementy)” - swobodne, nieszablonowe konstruowanie modeli przestrzennych w nawiązaniu do tematu tygodnia.`,
                `3. „Kodowanie na dywanie” - układanie logicznych sekwencji i programowanie drogi bez użycia ekranów do obiektów z obszaru: ${t}.`,
                `4. „Edukacja badawcza i techniczna” - stawianie hipotez i sprawdzanie założeń za pomocą narzędzi, takich jak miarka, lejki czy waga.`,
                `5. „Matematyka w przestrzeni” - klasyfikowanie zbiorów, segregowanie kolorami i kształtami elementów kojarzących się z zagadnieniem: ${t}.`,
                `6. „Zabawy wielozmysłowe” - polisensoryczne (dotyk, węch) poznawanie i kategoryzowanie ukrytych przedmiotów powiązanych z: ${t}.`,
                `7. „Kierowane odkrywanie (facylitacja)” - moderowana dyskusja, w której nauczyciel nie podaje gotowych rozwiązań, lecz zachęca do analizy problemu.`
            ];

            return { ruchowe, powietrze, edukacyjne };
        }

        // Inicjalizacja
        const monthsNames = Object.keys(yearlyCurriculum);
        
        window.onload = () => {
            const mSel = document.getElementById("monthSelect");
            monthsNames.forEach(m => mSel.add(new Option(m, m)));
            updateWeeksAndThemes();
        };

        function updateWeeksAndThemes() {
            const wSel = document.getElementById("weekSelect");
            wSel.innerHTML = "";
            for (let i = 1; i <= 4; i++) {
                wSel.add(new Option(`Tydzień ${i}`, i));
            }
            updateThemes();
        }

        function updateThemes() {
            const tSel = document.getElementById("themeSelect");
            tSel.innerHTML = "";
            
            const m = document.getElementById("monthSelect").value;
            const wIdx = parseInt(document.getElementById("weekSelect").value) - 1;
            
            const themes = yearlyCurriculum[m][wIdx];
            themes.forEach((t) => {
                tSel.add(new Option(t, t));
            });

            renderData();
        }

        function renderData() {
            const month = document.getElementById("monthSelect").value;
            const weekIndex = parseInt(document.getElementById("weekSelect").value) - 1;
            const themeFull = document.getElementById("themeSelect").value;
            
            // Usunięcie prefiksów numeracji (np. "1. ")
            const themeClean = themeFull.replace(/^[0-9]\.\s/, '');

            document.getElementById("planMonthName").textContent = month;
            document.getElementById("planTopicName").textContent = themeClean;
            document.getElementById("parentTopicTitle").textContent = themeClean;
            document.getElementById("lessonTopic").textContent = themeClean;

            // Generowanie Planu Dni
            generateDynamicTable(themeClean, weekIndex);
            
            // Generowanie spersonalizowanych list dla konkretnego tematu
            const dynamicLists = generateDynamicLists(themeClean);
            renderList("planRuchoweList", dynamicLists.ruchowe);
            renderList("planPowietrzeList", dynamicLists.powietrze);
            renderList("planEdukacyjneList", dynamicLists.edukacyjne);
        }

        function generateDynamicTable(themeClean, weekIndex) {
            const tbody = document.getElementById("planTableBody");
            tbody.innerHTML = "";
            
            daysKeys.forEach((dayKey, index) => {
                const templatesForDay = planTemplates[dayKey];
                const variantIndex = (weekIndex + index) % templatesForDay.length; 
                const selectedTpl = templatesForDay[variantIndex];

                const syt = selectedTpl.syt.replace('{theme}', `<span class="dynamic-theme">${themeClean}</span>`);
                
                const tr = document.createElement("tr");
                tr.innerHTML = `
                    <td style="font-weight: bold; background: #fafafa;">${dayNames[index]}</td>
                    <td contenteditable="true">${syt}</td>
                    <td contenteditable="true">${selectedTpl.cel}</td>
                    <td contenteditable="true" style="font-size:0.85em; text-align:center;">${selectedTpl.obszar}</td>
                    <td contenteditable="true" style="font-size:0.85em; text-align:center;">${selectedTpl.komp}</td>
                `;
                tbody.appendChild(tr);
            });
        }

        function renderList(elementId, dataArray) {
            const ul = document.getElementById(elementId);
            ul.innerHTML = "";
            dataArray.forEach((item) => {
                const parts = item.split("” -");
                let formattedText = item;
                if(parts.length > 1) {
                    formattedText = `<span class="bold-start">${parts[0]}”</span> -${parts[1]}`;
                }
                const li = document.createElement("li");
                li.innerHTML = formattedText.replace(/^[0-9]+\.\s/, '');
                li.setAttribute("contenteditable", "true");
                ul.appendChild(li);
            });
        }

        function switchTab(tabId, element) {
            document.querySelectorAll('.module-view').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
            document.getElementById(tabId).classList.add('active');
            element.classList.add('active');
        }
    </script>
